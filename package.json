{
  "name": "@local/dsh-agent-activity-intelligence",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "type": "module",
  "description": "Evidence-backed agent outcomes, verification gaps, and sensitive-access alerts in the DSH sidebar.",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "docs/",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs all",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:package": "node scripts/check-package.mjs",
    "test:compatibility": "node scripts/check-dsh-compatibility.mjs",
    "check": "node --check src/index.js && node --check src/engine.js && node --check src/coordinator.js && node --check src/change-context.js && node --check src/syntax-highlight.js && node --check src/unified-diff.js && node --check src/full-file-context.js && node --check src/recorded-files.js && node --check src/model-settings.js && node --check src/workspace.js && node --check src/client.js"
  },
  "dependencies": {
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "zod": "^4.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-deliverables",
        "@deepseek-ai/dsh-client-ui-open-in-app",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
